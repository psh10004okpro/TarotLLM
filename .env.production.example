# =============================================================================
# Unwoldam Tarot LLM API - Production Environment Variables
# Phase 12: 프로덕션 배포
# =============================================================================

# -----------------------------------------------------------------------------
# API Settings
# -----------------------------------------------------------------------------
API_V1_STR=/api/v1
PROJECT_NAME=Unwoldam Tarot API
VERSION=1.1.0

# CORS Settings - Production (도메인 목록으로 수정 필요)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com

# -----------------------------------------------------------------------------
# LLM Provider API Keys (필수)
# -----------------------------------------------------------------------------

# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# LLM Model Settings
# -----------------------------------------------------------------------------
CLAUDE_MODEL=claude-sonnet-4-5-20250929
OPENAI_MODEL=gpt-4-turbo
GEMINI_MODEL=gemini-pro

# Default LLM Provider
DEFAULT_LLM_PROVIDER=claude

# -----------------------------------------------------------------------------
# Redis (Production)
# -----------------------------------------------------------------------------

# Redis URL - Production
# AWS ElastiCache: redis://your-elasticache-endpoint:6379/0
# Redis Cloud: redis://username:password@host:port/db
REDIS_URL=redis://redis:6379/0

# Redis 키 만료 시간 (일 단위)
REDIS_KEY_EXPIRY_DAYS=90

# -----------------------------------------------------------------------------
# RAG Settings
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE_PATH=./data/vector_store
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# RAG 검색 결과 개수
RAG_TOP_K=5

# 타로카드 데이터 경로
TAROT_CARDS_PATH=data/tarot_cards

# -----------------------------------------------------------------------------
# Session Settings
# -----------------------------------------------------------------------------
SESSION_EXPIRY_HOURS=24
MAX_SESSION_HISTORY=100

# -----------------------------------------------------------------------------
# Tarot System Settings
# -----------------------------------------------------------------------------

# 기본 타로마스터
DEFAULT_TAROT_MASTER=master_1

# 기본 스프레드 타입
DEFAULT_SPREAD_TYPE=three_card

# 프롬프트 최적화
USE_OPTIMIZED_PROMPTS=true
USE_DETAILED_ON_FIRST=true
USE_DETAILED_ON_COMPLEX=true
PROMPT_TOKEN_BUDGET=4000

# -----------------------------------------------------------------------------
# Logging (Production)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=/app/logs/tarot_api.log

# Sentry DSN (선택적 - 에러 트래킹)
# SENTRY_DSN=your_sentry_dsn_here

# -----------------------------------------------------------------------------
# Server Settings (Production)
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=production

# Gunicorn Workers (CPU 코어 수 * 2 + 1 권장)
WORKERS=4
TIMEOUT=120

# -----------------------------------------------------------------------------
# Security (Production)
# -----------------------------------------------------------------------------

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10

# HTTPS Only (프로덕션에서는 true 권장)
HTTPS_ONLY=true

# Secret Key (세션 암호화 등에 사용 - 변경 필수!)
SECRET_KEY=change_this_to_a_random_secret_key_in_production

# -----------------------------------------------------------------------------
# Monitoring & Metrics (선택적)
# -----------------------------------------------------------------------------

# Prometheus metrics endpoint
METRICS_ENABLED=true

# Application Performance Monitoring
# APM_SERVICE_NAME=unwoldam-tarot-api
# APM_SERVER_URL=your_apm_server_url

# -----------------------------------------------------------------------------
# Database Settings (향후 구현)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://user:password@host/tarot_db

# -----------------------------------------------------------------------------
# Cloud Provider Settings (선택적)
# -----------------------------------------------------------------------------

# AWS Settings
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# S3 Bucket (로그 저장 등)
# S3_BUCKET_NAME=your-bucket-name

# CloudWatch Logs
# CLOUDWATCH_LOG_GROUP=/aws/tarot-api
