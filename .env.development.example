# =============================================================================
# Unwoldam Tarot LLM API - Development Environment Variables
# Phase 12: 프로덕션 배포
# =============================================================================

# -----------------------------------------------------------------------------
# API Settings
# -----------------------------------------------------------------------------
API_V1_STR=/api/v1
PROJECT_NAME=Unwoldam Tarot API (Dev)
VERSION=1.1.0

# CORS Settings - Development (모든 localhost 허용)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# LLM Provider API Keys (필수)
# -----------------------------------------------------------------------------

# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# LLM Model Settings
# -----------------------------------------------------------------------------
CLAUDE_MODEL=claude-sonnet-4-5-20250929
OPENAI_MODEL=gpt-4-turbo
GEMINI_MODEL=gemini-pro

# Default LLM Provider
DEFAULT_LLM_PROVIDER=claude

# -----------------------------------------------------------------------------
# Redis (Development)
# -----------------------------------------------------------------------------

# Redis URL - Development (주석 처리하면 메모리 기반 저장소 사용)
# REDIS_URL=redis://localhost:6379/0

# Redis 키 만료 시간 (일 단위)
REDIS_KEY_EXPIRY_DAYS=7

# -----------------------------------------------------------------------------
# RAG Settings
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE_PATH=./data/vector_store
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# RAG 검색 결과 개수
RAG_TOP_K=5

# 타로카드 데이터 경로
TAROT_CARDS_PATH=data/tarot_cards

# -----------------------------------------------------------------------------
# Session Settings
# -----------------------------------------------------------------------------
SESSION_EXPIRY_HOURS=24
MAX_SESSION_HISTORY=100

# -----------------------------------------------------------------------------
# Tarot System Settings
# -----------------------------------------------------------------------------

# 기본 타로마스터
DEFAULT_TAROT_MASTER=master_1

# 기본 스프레드 타입
DEFAULT_SPREAD_TYPE=three_card

# 프롬프트 최적화
USE_OPTIMIZED_PROMPTS=true
USE_DETAILED_ON_FIRST=true
USE_DETAILED_ON_COMPLEX=true
PROMPT_TOKEN_BUDGET=4000

# -----------------------------------------------------------------------------
# Logging (Development)
# -----------------------------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_FILE=logs/tarot_api.log

# -----------------------------------------------------------------------------
# Server Settings (Development)
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Development/Testing Settings
# -----------------------------------------------------------------------------

# 테스트 모드 (true이면 실제 LLM API 호출 안 함)
TEST_MODE=false

# Mock 응답 사용 여부
USE_MOCK_RESPONSES=false

# Hot reload (자동 재시작)
RELOAD=true
