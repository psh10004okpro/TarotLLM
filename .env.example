# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=Unwoldam Tarot API
VERSION=1.0.0

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# LLM Provider API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# LLM Model Settings
CLAUDE_MODEL=claude-sonnet-4-5-20250929
OPENAI_MODEL=gpt-4-turbo
GEMINI_MODEL=gemini-pro

# Default LLM Provider (claude, openai, or gemini)
DEFAULT_LLM_PROVIDER=claude

# RAG Settings
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE_PATH=./data/vector_store
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Session Settings
SESSION_EXPIRY_HOURS=24
MAX_SESSION_HISTORY=100

# TTS/STT Settings (for future implementation)
# TTS_PROVIDER=
# STT_PROVIDER=

# Database Settings (for future implementation)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/tarot_db

# Logging
LOG_LEVEL=INFO

# Server Settings
HOST=0.0.0.0
PORT=8000
