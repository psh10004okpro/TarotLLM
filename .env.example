# =============================================================================
# Unwoldam Tarot LLM API - Environment Variables
# Phase 10: 통합 및 테스트
# =============================================================================

# -----------------------------------------------------------------------------
# API Settings
# -----------------------------------------------------------------------------
API_V1_STR=/api/v1
PROJECT_NAME=Unwoldam Tarot API
VERSION=1.0.0

# CORS Settings (콤마로 구분)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# LLM Provider API Keys (필수)
# -----------------------------------------------------------------------------

# Anthropic Claude API Key
# https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
# https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# LLM Model Settings
# -----------------------------------------------------------------------------
CLAUDE_MODEL=claude-sonnet-4-5-20250929
OPENAI_MODEL=gpt-4-turbo
GEMINI_MODEL=gemini-pro

# Default LLM Provider (claude, openai, or gemini)
DEFAULT_LLM_PROVIDER=claude

# -----------------------------------------------------------------------------
# Redis (Phase 8: 세션 관리)
# -----------------------------------------------------------------------------

# Redis URL
# 로컬 개발: redis://localhost:6379/0
# Docker: redis://redis:6379/0
# Redis Cloud: redis://username:password@host:port/db
# 주석 처리하면 메모리 기반 저장소 사용
# REDIS_URL=redis://localhost:6379/0

# Redis 키 만료 시간 (일 단위)
REDIS_KEY_EXPIRY_DAYS=90

# -----------------------------------------------------------------------------
# RAG Settings (Phase 4)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE_PATH=./data/vector_store
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# RAG 검색 결과 개수
RAG_TOP_K=5

# 타로카드 데이터 경로
TAROT_CARDS_PATH=data/tarot_cards

# -----------------------------------------------------------------------------
# Session Settings (Phase 8)
# -----------------------------------------------------------------------------
SESSION_EXPIRY_HOURS=24
MAX_SESSION_HISTORY=100

# -----------------------------------------------------------------------------
# Tarot System Settings (Phase 5-9)
# -----------------------------------------------------------------------------

# 기본 타로마스터 (master_1, master_2, master_3)
DEFAULT_TAROT_MASTER=master_1

# 기본 스프레드 타입 (single_card, three_card, celtic_cross)
DEFAULT_SPREAD_TYPE=three_card

# 프롬프트 최적화 사용 여부 (Phase 6)
USE_OPTIMIZED_PROMPTS=true

# 첫 만남에 DETAILED 프롬프트 사용
USE_DETAILED_ON_FIRST=true

# 복잡한 질문에 DETAILED 프롬프트 사용
USE_DETAILED_ON_COMPLEX=true

# 프롬프트 토큰 예산
PROMPT_TOKEN_BUDGET=4000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/tarot_api.log

# -----------------------------------------------------------------------------
# Server Settings
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Development/Testing Settings
# -----------------------------------------------------------------------------

# 테스트 모드 (true이면 실제 LLM API 호출 안 함)
TEST_MODE=false

# Mock 응답 사용 여부
USE_MOCK_RESPONSES=false

# -----------------------------------------------------------------------------
# Database Settings (for future implementation)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/tarot_db

# -----------------------------------------------------------------------------
# TTS/STT Settings (for future implementation)
# -----------------------------------------------------------------------------
# TTS_PROVIDER=
# STT_PROVIDER=

